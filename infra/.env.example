# Gateway + Valkey settings, read by docker compose. Copy to infra/.env (gitignored)
# and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────────────────────────
# Admin key for the gateway (admin UI login, minting virtual keys). Never give it to the app.
# Generate:  macOS/Linux: echo "sk-$(openssl rand -hex 32)"
#            PowerShell:  see README.md step 3 (uses a cryptographic RNG)
LITELLM_MASTER_KEY=
# Encrypts credentials stored in Postgres. Generate the same way.
# Keep it: changing it later makes stored credentials unreadable.
LITELLM_SALT_KEY=
# Your GCP project with the Vertex AI API enabled.
VERTEX_PROJECT=
# Vertex region for the models in config/config.yaml.
VERTEX_LOCATION=us-east1

# ── Optional (unset = value in parentheses) ──────────────────────────────────
# Host port for the gateway, bound to 127.0.0.1                    (4000)
# LITELLM_PORT=4000
# Host port for Valkey, bound to 127.0.0.1                         (6379)
# VALKEY_PORT=6379
# gcloud Application Default Credentials file to mount read-only
#   (~/.config/gcloud/application_default_credentials.json)
#   Windows: C:/Users/<you>/AppData/Roaming/gcloud/application_default_credentials.json
#   (that is %APPDATA%\gcloud\..., written with forward slashes)
# GCLOUD_ADC_PATH=
# Password of the gateway's internal Postgres (not exposed outside Docker)  (litellm)
# POSTGRES_PASSWORD=
