# App settings. Copy to .env (gitignored) and fill in. Never commit .env.
# Gateway secrets live separately in infra/.env.

# ── Required ─────────────────────────────────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
# A LiteLLM *virtual key* (sk-...) scoped to the two models — never the master key.
# See README.md → "5. Mint the app's virtual key".
LITELLM_API_KEY=

# ── Optional (unset = value in parentheses) ──────────────────────────────────
# Gateway alias for answers and the ADK agent                       (gemini-2.5-flash)
# LLM_MODEL=gemini-2.5-flash
# Gateway alias for ingestion, retrieval and the cache              (gemini-embedding-001)
# EMBEDDING_MODEL=gemini-embedding-001

# Markdown docs to ingest                                           (data)
# DATA_PATH=data
# Where index.faiss + chunks.json are written                       (vector_store)
# VECTOR_STORE_PATH=vector_store
# Max characters per chunk after the Markdown header split          (1500)
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150
# Chunks retrieved per question                                     (4)
# TOP_K=4

# ── Semantic cache ───────────────────────────────────────────────────────────
# VALKEY_HOST=localhost
# Must match VALKEY_PORT in infra/.env if you changed it there      (6379)
# VALKEY_PORT=6379
# Valkey key prefix / index name for this cache                     (ragcache)
# SEMANTIC_CACHE_NAME=ragcache
# Max cosine DISTANCE for a hit (0 = identical). Tuned for gemini-embedding-001  (0.13)
# SEMANTIC_CACHE_THRESHOLD=0.13
# Model name BetterDB prices saved calls with                       (gemini-2.5-flash)
# CACHE_COST_MODEL=gemini-2.5-flash
# BetterDB anonymous usage analytics (PostHog). Off unless true     (false)
# BETTERDB_TELEMETRY=false

# ── Streamlit ────────────────────────────────────────────────────────────────
# BACKEND_URL=http://localhost:8000

# ── Optional: AWS ElastiCache Serverless with IAM auth instead of local Valkey ──
# Set VALKEY_HOST/VALKEY_PORT to the ElastiCache endpoint; AWS credentials come from
# the usual botocore chain (env vars, ~/.aws, instance role).
# VALKEY_USE_IAM_AUTH=false
# VALKEY_IAM_USER_ID=default.iam-user
# VALKEY_SERVERLESS_CACHE_NAME=
# AWS_REGION=us-east-2
